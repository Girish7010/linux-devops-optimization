# Copy to /etc/devops-optimization/alert.env and edit (chmod 600 - it holds secrets).
# install.sh creates it for you from this template if it does not exist.

# Thresholds (percent)
DISK_THRESHOLD=80
INODE_THRESHOLD=80
MEM_THRESHOLD=85
CPU_THRESHOLD=90
# Alert when 1-min load > cores x this number
LOAD_PER_CORE_THRESHOLD=2
# Do not repeat the same alert more often than this (minutes)
COOLDOWN_MIN=30

# Slack: create an Incoming Webhook and paste the URL
SLACK_WEBHOOK_URL=

# Telegram: create a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
